# touch - создание файла
function touch {
    param([string]$path)
    if (Test-Path $path) {
        (Get-Item $path).LastWriteTime = Get-Date
    } else {
        New-Item -Path $path -ItemType File | Out-Null
    }
}

# grep - поиск текста в файлах
function grep {
    param(
        [string]$pattern,
        [string]$path = "."
    )
    Get-ChildItem -Path $path -Recurse -File -ErrorAction SilentlyContinue | 
        Select-String -Pattern $pattern
}

# find - поиск файлов
function find {
    param(
        [string]$name,
        [string]$path = "."
    )
    Get-ChildItem -Path $path -Recurse -Filter $name -ErrorAction SilentlyContinue
}

# du - размер директории
function du {
    param([string]$path = ".")
    if (Test-Path $path) {
        $size = (Get-ChildItem -Path $path -Recurse -File -ErrorAction SilentlyContinue | 
                 Measure-Object -Property Length -Sum).Sum
        if ($size -gt 1TB) {
            "{0:N2} TB" -f ($size / 1TB)
        } elseif ($size -gt 1GB) {
            "{0:N2} GB" -f ($size / 1GB)
        } elseif ($size -gt 1MB) {
            "{0:N2} MB" -f ($size / 1MB)
        } elseif ($size -gt 1KB) {
            "{0:N2} KB" -f ($size / 1KB)
        } else {
            "$size B"
        }
    } else {
        Write-Host Put ne naiden: $path -ForegroundColor Red
    }
}

# tree - дерево папок
function tree {
    param(
        [string]$path = ".",
        [int]$depth = 3
    )
    function Show-Tree {
        param(
            [string]$currentPath,
            [string]$indent = "",
            [int]$currentDepth = 0
        )
        if ($currentDepth -gt $depth) { return }
        
        $items = Get-ChildItem -Path $currentPath -ErrorAction SilentlyContinue
        foreach ($item in $items) {
            if ($item.PSIsContainer) {
                Write-Host "$indent+-- $($item.Name)/" -ForegroundColor Cyan
                Show-Tree -currentPath $item.FullName -indent "$indent|   " -currentDepth ($currentDepth + 1)
            } else {
                $size = if ($item.Length -gt 1MB) {
                    "{0:N1} MB" -f ($item.Length / 1MB)
                } elseif ($item.Length -gt 1KB) {
                    "{0:N1} KB" -f ($item.Length / 1KB)
                } else {
                    "$($item.Length) B"
                }
                Write-Host "$indent+-- $($item.Name) ($size)" -ForegroundColor White
            }
        }
    }
    
    $pathName = if ($path -eq ".") { (Get-Location).Path } else { $path }
    Write-Host "$pathName/" -ForegroundColor Yellow
    Show-Tree -currentPath $path
}

# head - первые строки файла
function head {
    param(
        [string]$path,
        [int]$lines = 10
    )
    Get-Content -Path $path -Head $lines
}

# tail - последние строки файла
function tail {
    param(
        [string]$path,
        [int]$lines = 10
    )
    Get-Content -Path $path -Tail $lines
}

# wc - подсчет строк/слов/байт
function wc {
    param([string]$path)
    $content = Get-Content -Path $path -ErrorAction SilentlyContinue
    $lines = $content.Count
    $words = ($content | ForEach-Object { $_ -split '\s+' | Where-Object { $_ } }).Count
    $chars = ($content | Measure-Object -Character).Characters
    Write-Host "$lines strings, $words words, $chars chars" -ForegroundColor Green
}

# ps - список процессов
function ps {
    param([string]$name)
    if ($name) {
        Get-Process -Name "*$name*" | Format-Table -AutoSize
    } else {
        Get-Process | Format-Table -AutoSize
    }
}

# kill - убить процесс по PID
function kill {
    param([int]$pid)
    Stop-Process -Id $pid -Force
}

# df - информация о дисках
function df {
    Get-PSDrive -PSProvider FileSystem | 
        Select-Object @{N=Filesystem;E={$_.Root}},
                      @{N=Size;E={"{0:N2} GB" -f (($_.Used + $_.Free) / 1GB)}},
                      @{N=Used;E={"{0:N2} GB" -f ($_.Used / 1GB)}},
                      @{N=Avail;E={"{0:N2} GB" -f ($_.Free / 1GB)}},
                      @{N=Use%;E={[math]::Round(($_.Used / ($_.Used + $_.Free)) * 100)}} |
        Format-Table -AutoSize
}

# wget - скачивание файлов
function wget {
    param(
        [string]$url,
        [string]$output
    )
    if ($output) {
        Invoke-WebRequest -Uri $url -OutFile $output
    } else {
        Invoke-WebRequest -Uri $url
    }
}

# curl - запросы к серверу
function curl {
    param(
        [string]$url,
        [string]$method = "GET"
    )
    Invoke-WebRequest -Uri $url -Method $method
}

# unzip - распаковка zip
function unzip {
    param(
        [string]$zipPath,
        [string]$destination = "."
    )
    Expand-Archive -Path $zipPath -DestinationPath $destination -Force
}

# zip - упаковка в zip
function zip {
    param(
        [string]$sourcePath,
        [string]$destinationPath
    )
    Compress-Archive -Path $sourcePath -DestinationPath $destinationPath -Force
}

# whoami - кто я
function whoami {
    [System.Security.Principal.WindowsIdentity]::GetCurrent().Name
}

