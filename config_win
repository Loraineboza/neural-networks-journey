function cd {
    param([string]$Path)
    
    if ($Path -eq "-") {
        # Переход в предыдущую директорию
        if ($global:OLDPWD) {
            Set-Location $global:OLDPWD
        }
    } elseif ($Path -eq "~" -or $Path -eq "") {
        Set-Location $HOME
    } elseif ($Path -eq "..") {
        Set-Location ..
    } else {
        $global:OLDPWD = (Get-Location).Path
        Set-Location $Path
    }
}

# pwd с поддержкой -P
function pwd {
    param([switch]$P)
    if ($P) {
        (Get-Location).Path
    } else {
        Get-Location
    }
}

function l {
    Get-ChildItem -Name
}

function ll {
    Get-ChildItem -Force | Format-Table -AutoSize
}

function la {
    Get-ChildItem -Force -Name
}

function ls-l {
    Get-ChildItem -Force | Format-Table -AutoSize
}

# Переопределяем ls для поддержки -l, -la, -a
function ls {
    param(
        [string]$Path = ".",
        [switch]$l,
        [switch]$a,
        [switch]$la,
        [switch]$al
    )
    
    if ($l) {
        Get-ChildItem -Path $Path -Force | Format-Table -AutoSize
    } elseif ($a) {
        Get-ChildItem -Path $Path -Force -Name
    } elseif ($la -or $al) {
        Get-ChildItem -Path $Path -Force | Format-Table -AutoSize
    } else {
        Get-ChildItem -Path $Path
    }
}

# grep с поддержкой -r, -i и других флагов
function grep {
    param(
        [string]$Pattern,
        [string]$Path = ".",
        [switch]$r,
        [switch]$i,
        [switch]$n,
        [switch]$v,
        [switch]$c
    )
    
    $params = @{}
    if ($r) { $params.Recurse = $true }
    if ($i) { $params.CaseSensitive = $false } else { $params.CaseSensitive = $true }
    if ($n) { 
        Get-ChildItem -Path $Path -Recurse:$r -File -ErrorAction SilentlyContinue | 
            Select-String -Pattern $Pattern -CaseSensitive:(!$i) | 
            ForEach-Object { "$($_.Filename):$($_.LineNumber):$($_.Line)" }
        return
    }
    if ($v) {
        Get-ChildItem -Path $Path -Recurse:$r -File -ErrorAction SilentlyContinue | 
            Select-String -Pattern $Pattern -NotMatch -CaseSensitive:(!$i)
        return
    }
    if ($c) {
        $count = (Get-ChildItem -Path $Path -Recurse:$r -File -ErrorAction SilentlyContinue | 
                  Select-String -Pattern $Pattern -CaseSensitive:(!$i)).Count
        Write-Host $count
        return
    }
    
    Get-ChildItem -Path $Path -Recurse:$r -File -ErrorAction SilentlyContinue | 
        Select-String -Pattern $Pattern -CaseSensitive:(!$i)
}

# rm с поддержкой -rf
function rm {
    param(
        [string]$Path,
        [switch]$r,
        [switch]$f,
        [switch]$rf
    )
    
    if ($r -or $rf) {
        Remove-Item -Path $Path -Recurse -Force -ErrorAction SilentlyContinue
    } elseif ($f) {
        Remove-Item -Path $Path -Force -ErrorAction SilentlyContinue
    } else {
        Remove-Item -Path $Path -ErrorAction SilentlyContinue
    }
}

# cp с поддержкой -r
function cp {
    param(
        [string]$Source,
        [string]$Destination,
        [switch]$r
    )
    
    if ($r) {
        Copy-Item -Path $Source -Destination $Destination -Recurse
    } else {
        Copy-Item -Path $Source -Destination $Destination
    }
}

# mv с поддержкой -f
function mv {
    param(
        [string]$Source,
        [string]$Destination,
        [switch]$f
    )
    
    if ($f) {
        Move-Item -Path $Source -Destination $Destination -Force
    } else {
        Move-Item -Path $Source -Destination $Destination
    }
}
	

function which {
    param(
        [string]$Command,
        [switch]$a
    )
    if ($a) {
        Get-Command -Name $Command -All | Select-Object -ExpandProperty Source
    } else {
        Get-Command -Name $Command | Select-Object -ExpandProperty Source
    }
}

